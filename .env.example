# ==========================================
# DAOS - Variables d'Environnement Docker (EXEMPLE)
# ==========================================
# Copier ce fichier vers .env et remplir avec vos valeurs
# cp .env.example .env

# ==========================================
# MYSQL DATABASE
# ==========================================
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=daos_db
MYSQL_HOST=mysql
MYSQL_PORT=3306

DB_USERNAME=root
DB_PASSWORD=your_database_password

# ==========================================
# REDIS
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379

# ==========================================
# EUREKA SERVER
# ==========================================
EUREKA_SERVER_PORT=8761
EUREKA_SERVER_HOST=eureka-server
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server:8761/eureka/

# ==========================================
# CONFIG SERVER
# ==========================================
CONFIG_SERVER_PORT=8888
CONFIG_SERVER_HOST=config-server
SPRING_CLOUD_CONFIG_URI=http://config-server:8888

# ==========================================
# API GATEWAY
# ==========================================
API_GATEWAY_PORT=8080
API_GATEWAY_HOST=api-gateway

# ==========================================
# MICROSERVICES PORTS
# ==========================================
AUTH_SERVICE_PORT=8081
ENSEIGNANT_SERVICE_PORT=8082
MAQUETTE_SERVICE_PORT=8083
CHOIX_ENSEIGNEMENT_SERVICE_PORT=8084
EMPLOI_TEMPS_SERVICE_PORT=8085
DEROULEMENT_ENSEIGNEMENT_SERVICE_PORT=8086

# ==========================================
# FRONT-END
# ==========================================
FRONTEND_PORT=3000
REACT_APP_API_GATEWAY_URL=http://localhost:8080

# ==========================================
# JWT CONFIGURATION
# ==========================================
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRATION=86400000

# ==========================================
# SPRING PROFILES
# ==========================================
SPRING_PROFILES_ACTIVE=dev

# ==========================================
# JPA/HIBERNATE CONFIGURATION
# ==========================================
SPRING_JPA_SHOW_SQL=true
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ==========================================
# LOGGING LEVELS
# ==========================================
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_DAOS=DEBUG
LOGGING_LEVEL_SPRING=INFO

# ==========================================
# ACTUATOR CONFIGURATION
# ==========================================
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,refresh,env

# ==========================================
# DOCKER NETWORK
# ==========================================
DOCKER_NETWORK_NAME=daos-network

# ==========================================
# VOLUMES
# ==========================================
MYSQL_VOLUME_NAME=mysql-data
